				{
					"name": "Admin Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const responseJson = pm.response.json();",
									"if (responseJson.accessToken) {",
									"    pm.environment.set(\"token\", responseJson.accessToken);",
									"    pm.globals.set(\"token\", responseJson.accessToken);",
									"    console.log(\"Token guardado automáticamente en la variable 'token'\");",
									"}"
								],
								"type": "javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"admin@mita.ai\",\n    \"password\": \"admin123\"\n}"
						},
